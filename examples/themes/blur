#!/bin/sh
THEME_NAME="Blurred screen"
THEME_DESCRIPTION="A blurred, frozen snapshot of the screen as it was when it went idle."
THEME_VERSION="1.0"
THEME_REQUIRES="grim ffmpeg mpv"
THEME_USAGE="blur [--dim PERCENT] [PERCENT]"

# Options:
#   PERCENT          how much to blur, 0-100; default 50
#   --dim PERCENT    also darken it, 0-100; default 0
#
# Example: waysaver 300 blur --dim 40 70
#
# The snapshot is frozen: on Wayland only the compositor can see other
# windows, so a live blur is impossible for a program. It is taken with grim,
# which needs the wlr-screencopy protocol (labwc, Sway, Hyprland, river,
# niri...; not KDE). Don't combine it with --backdrop, which would be in the
# snapshot instead of the desktop.

for dep in $THEME_REQUIRES; do
    command -v "$dep" >/dev/null || { echo "$0: $dep is not installed" >&2; exit 1; }
done

fail() { echo "$0: $*" >&2; exit 2; }

# Whether $1 is a whole number from 0 to 100.
is_percent() {
    case $1 in '' | *[!0-9]*) return 1 ;; esac
    [ "$1" -le 100 ]
}

dim=0
if [ "${1:-}" = --dim ]; then
    # Checked first: in dash, a failed `shift` exits the script.
    [ $# -ge 2 ] || fail "--dim needs a value"
    dim=$2
    shift 2
fi
blur=${1:-50}
is_percent "$blur" || fail "the blur must be a percentage (0-100)"
is_percent "$dim" || fail "--dim must be a percentage (0-100)"

dir=${XDG_RUNTIME_DIR:-/tmp}/waysaver-blur
mkdir -p "$dir"
shot=$dir/${WAYSAVER_OUTPUT:-screen}.png

# By now waysaver's cover on this monitor has turned transparent; give the
# compositor a moment to show the desktop again, then take the snapshot (of
# this monitor only, with multimonitor).
sleep 0.3
grim ${WAYSAVER_OUTPUT:+-o "$WAYSAVER_OUTPUT"} "$shot" || exit 1

# A gaussian blur (sigma up to 40 pixels) and a darkening (a multiplier).
filter=$(awk -v b="$blur" -v d="$dim" 'BEGIN {
    printf "gblur=sigma=%.1f,colorchannelmixer=rr=%.2f:gg=%.2f:bb=%.2f", b * 0.4 + 0.01, 1 - d / 100, 1 - d / 100, 1 - d / 100
}')
ffmpeg -loglevel error -y -i "$shot" -vf "$filter" "$shot.blurred.png" || exit 1

# --stop-screensaver=no: a playing mpv otherwise asks the compositor not to
# blank, which may wake the screen right away.
exec mpv --fs --no-osc --no-audio --image-display-duration=inf --stop-screensaver=no \
    ${WAYSAVER_OUTPUT:+--fs-screen-name="$WAYSAVER_OUTPUT"} "$shot.blurred.png"
