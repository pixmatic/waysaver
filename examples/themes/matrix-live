#!/bin/sh
THEME_NAME="Matrix over the desktop"
THEME_DESCRIPTION="The Matrix rain over the live desktop, in a transparent terminal."
THEME_VERSION="1.1"
THEME_REQUIRES="foot cmatrix"
THEME_USAGE="matrix-live [--color NAME]"

# Example: waysaver 300 matrix-live --color red
#
# Options:
#   --color NAME   black, red, green, yellow, blue, magenta, cyan or white; default green

for dep in $THEME_REQUIRES; do
    command -v "$dep" >/dev/null || { echo "$0: $dep is not installed" >&2; exit 1; }
done

fail() { echo "$0: $*" >&2; exit 2; }
# Whether $1 is a color as RRGGBB (hex).
is_rgb() { case $1 in [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;; *) return 1 ;; esac; }
# The terminal color number (0-7) of a color name.
color_index() {
    case $1 in
        black) echo 0 ;; red) echo 1 ;; green) echo 2 ;; yellow) echo 3 ;;
        blue) echo 4 ;; magenta) echo 5 ;; cyan) echo 6 ;; white) echo 7 ;;
        *) return 1 ;;
    esac
}

color=green
while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || case $1 in --*) fail "$1 needs a value" ;; esac
    case $1 in
        --color) color=$2 ;;
        *) fail "unknown option: $1" ;;
    esac
    shift 2
done
color_index "$color" >/dev/null || fail "--color must be black, red, green, yellow, blue, magenta, cyan or white"

# Maximized rather than fullscreen: at least on labwc, a fullscreen window is
# drawn opaque. alpha-mode=all also makes transparent the cells painted with
# the "black" palette color, which cmatrix uses. No title bar (csd).
exec foot -o csd.preferred=none -o colors-dark.alpha=0.0 -o colors-dark.alpha-mode=all \
    --maximized sh -c 'sleep 0.3; exec cmatrix -b -C "$0"' "$color"
