#!/bin/sh
THEME_NAME="GLSL shader"
THEME_DESCRIPTION="A GLSL fragment shader from a file, fullscreen; a plasma one by default."
THEME_VERSION="1.0"
THEME_REQUIRES="glslViewer"
THEME_USAGE="shader [FILE.frag]"

# FILE.frag: a fragment shader using glslViewer's uniforms (u_time,
# u_resolution, u_mouse...). Without one, a built-in plasma shader is used.
#
# Example: wayvoid 300 shader ~/shaders/tunnel.frag

for dep in $THEME_REQUIRES; do
    command -v "$dep" >/dev/null || { echo "$0: $dep is not installed" >&2; exit 1; }
done

if [ $# -eq 0 ]; then
    set -- "${XDG_CACHE_HOME:-$HOME/.cache}/wayvoid/plasma.frag"
    mkdir -p "${1%/*}"
    cat > "$1" <<'FRAG'
uniform vec2 u_resolution;
uniform float u_time;
void main() {
    vec2 p = gl_FragCoord.xy / u_resolution;
    float v = sin(p.x * 10.0 + u_time) + sin(p.y * 10.0 + u_time * 1.3)
            + sin((p.x + p.y) * 10.0 + u_time * 0.7);
    gl_FragColor = vec4(0.5 + 0.5 * sin(v), 0.5 + 0.5 * sin(v + 2.0),
                        0.5 + 0.5 * sin(v + 4.0), 1.0);
}
FRAG
fi
[ -r "$1" ] || { echo "$0: can't read $1" >&2; exit 2; }
exec glslViewer "$1" --fullscreen
