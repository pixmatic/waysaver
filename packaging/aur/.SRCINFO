pkgbase = waysaver
	pkgdesc = Minimal Wayland screensaver: black screen or any program as a theme, respecting inhibitors
	pkgver = 1.0.0beta1
	pkgrel = 1
	url = https://github.com/pixmatic/waysaver
	install = waysaver.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	depends = dbus
	depends = gcc-libs
	depends = glibc
	optdepends = foot: terminal themes (matrix, clock, pipes, aquarium...)
	optdepends = cmatrix: matrix and matrix-live themes
	optdepends = figlet: marquee and jumpclock themes
	optdepends = tty-clock: clock theme
	optdepends = asciiquarium: aquarium theme
	optdepends = pipes.sh: pipes theme
	optdepends = cbonsai: bonsai theme
	optdepends = ffmpeg: life, mandelbrot and blur themes
	optdepends = mpv: video and blur themes
	optdepends = grim: blur theme
	optdepends = python-pygame: pipes3d theme
	optdepends = chromium: browser themes (text3d, maze3d, shadertoy, web), or firefox
	optdepends = firefox: browser themes (text3d, maze3d, shadertoy, web), or chromium
	optdepends = glslviewer: shader theme
	source = waysaver-1.0.0beta1.tar.gz::https://github.com/pixmatic/waysaver/archive/refs/tags/v1.0.0-beta.1.tar.gz
